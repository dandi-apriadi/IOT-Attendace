# ============================================================
# Konfigurasi Agent Relay ZKTeco
# Salin file ini menjadi .env lalu sesuaikan nilainya.
# ============================================================

# URL server (VPS). Tanpa trailing slash.
SERVER_URL=https://elektropolimdo.com

# Identitas perangkat di server (harus cocok dengan data devices di DB server).
# DEVICE_ID  = kolom device_id pada tabel devices
# DEVICE_TOKEN = token mentah perangkat (yang di-hash SHA-256 sebagai token_hash)
DEVICE_ID=X609-001
DEVICE_TOKEN=ganti-dengan-token-perangkat

# Alamat alat ZKTeco di jaringan lokal.
DEVICE_IP=192.168.0.10
DEVICE_PORT=4370

# Maksimum perintah yang diproses per sekali jalan (mencegah loop kepanjangan).
POLL_LIMIT=5

# Timeout HTTP ke server (detik).
HTTP_TIMEOUT=30
